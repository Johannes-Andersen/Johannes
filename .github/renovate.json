{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":pinAllExceptPeerDependencies"],
  "timezone": "Europe/Oslo",
  "schedule": ["* * * * 1"],
  "labels": ["type/dependencies"],
  "prConcurrentLimit": 4,
  "automerge": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["type/dependencies", "area/security", "priority/critical"]
  },
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "description": "Astro check requires the TypeScript 5 or 6 compiler API.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "6.x"
    },
    {
      "matchPackageNames": ["node", "@types/node"],
      "groupName": "Node.js runtime",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["npm", "nvm"],
      "matchPackageNames": ["node"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm",
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    }
  ]
}
