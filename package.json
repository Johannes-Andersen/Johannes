{
  "name": "johannes",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "postinstall": "lex install --ci",
    "lex:update": "lex install --update --save",
    "lex:build": "lex build --clear --lexicons ./lexicons --out ./src/lexicons",
    "predev": "pnpm run lex:build",
    "prebuild": "pnpm run lex:build",
    "pretest": "pnpm run lex:build",
    "pretype-check": "pnpm run lex:build",
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "types": "wrangler types",
    "test": "vitest",
    "type-check": "astro check && tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/sitemap": "3.7.4",
    "@atproto/lex": "0.3.14",
    "@atproto/lex-password-session": "0.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
